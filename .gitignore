node_modules/
dist/
build/
out/
*.tgz

# assembled by packages/cli/scripts/prepack.mjs at publish time, never committed
packages/cli/studio-dist/
packages/cli/templates/
packages/cli/LICENSE
packages/cli/LICENSE-APACHE-2.0-brand-spec
packages/cli/NOTICE
packages/cli/README.md
packages/cli/ASSETS-LICENSE.md
.pnpm-store/
.DS_Store
*.local
coverage/
*.log

# secrets. .env* is broad on purpose: it catches .env.local, .env.production
# and anything else someone reaches for in a hurry.
.env*
*.pem
*.key
*.p12
*.pfx
# `npm login` run anywhere inside this tree writes a project .npmrc with a
# plaintext _authToken in it. Nothing else would stop that being committed,
# and on a public repo one commit is one leaked token.
.npmrc

# agent and editor tooling. These write machine-local state into the repo, so
# they stay out wholesale.
.claude/*
.serena/
.cursor/
.remember/
.impeccable/
.aider*

# playwright
apps/studio/test-results/
apps/studio/playwright-report/
.playwright-mcp/
# Browser tooling writes a screenshot to whatever path it is handed, and a bare
# filename lands here. Deliberate imagery lives in docs/media/ or apps/studio/,
# so a picture at the repo root is always a stray one.
/*.png
/*.jpg
/*.jpeg
/*.gif
# visual-regression baselines: local pixels, captured per machine, never committed
apps/studio/visual/__screenshots__/

# local working material that never ships: design scratch and internal notes.
# No trailing slash on docs/design: it may be a symlink, and a trailing slash
# would miss it.
docs/design
docs/research/
docs/product/
/PRODUCT.md

# disposable local bundles, rebuilt on demand, never committed
.context/

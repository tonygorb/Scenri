# secrets. .env* is broad on purpose: it catches .env.local, .env.production
# and anything else someone reaches for in a hurry.
.env*
*.pem
*.key
*.p12
*.pfx

# agent and editor tooling. These write into the repo and have already leaked
# an absolute home path once, so they stay out.
.claude/
.serena/
.cursor/
.remember/
.aider*

# playwright
apps/studio/test-results/
apps/studio/playwright-report/
.playwright-mcp/

# design mockups. Tony sketches new pages and components as static HTML here
# before building them for real. That is a personal pre-code step, so it lives
# in a private working repo and this path is a symlink to it. No trailing
# slash: git sees a symlink, not a directory, and a trailing slash would miss it.
docs/design

# local research notes — keep off GitHub
docs/research/

#!/bin/sh
# Block a commit that contains anything shaped like a credential.
#
# GitHub's own push protection is free on public repositories only, so while
# this repo is private this hook is the thing standing between a stray API key
# and the history. It runs on staged changes only, so it is fast.
#
# Install: git config core.hooksPath .githooks
# Bypass once, deliberately: git commit --no-verify

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found, skipping the secret scan."
  echo "            install it with: brew install gitleaks"
  exit 0
fi

if ! gitleaks protect --staged --redact --no-banner; then
  echo ""
  echo "pre-commit: BLOCKED. Something in the staged changes looks like a secret."
  echo "  Values above are redacted on purpose."
  echo "  If it is a real credential: unstage it, and rotate the key. It is burned."
  echo "  If it is a false positive: add a rule to .gitleaks.toml, not --no-verify."
  exit 1
fi

# Competitor names stay out of the tree: this is a public repo, and product
# comparisons belong in private notes, not in shipped code or docs.
names='kive|canva|freepik|photoroom|pebblely|midjourney|recraft|mokker|claid|higgsfield|magnific|krea|ideogram'
hits=$(git diff --cached --unified=0 -- . ':(exclude).githooks/pre-commit' | grep -E '^\+' | grep -iwE "$names" || true)
if [ -n "$hits" ]; then
  echo ""
  echo "pre-commit: BLOCKED. A staged line names a competitor product:"
  echo "$hits" | head -5
  echo "  Describe the pattern instead of naming the product, or --no-verify if truly deliberate."
  exit 1
fi

# The product is Scenri; `scenri` is an identifier (DESIGN.md §6, "Writing").
# Two passes, because backticks mean different things in each: in markdown they
# fence a command or a path, in source they are an ordinary template literal.
# This is the early warning; copyHygiene.test.ts is the authority.
name_re='(^|[^@/._~:[:alnum:]-])scenri([^/._:@[:alnum:]-]|\.[^[:alnum:]]|\.$|$)'
allow='npx scenri|scenri (serve|update|--version|--help)|["'"'"']scenri["'"'"']|^\+\s*(cd|npm|pnpm|npx|git|node) '

md=$(git diff --cached --unified=0 -- '*.md' | grep -E '^\+' | grep -v '^+++' | sed 's/`[^`]*`//g')
src=$(git diff --cached --unified=0 -- '*.ts' '*.tsx' '*.mjs' '*.css' '*.html' '*.svg' '*.yml' \
  ':(exclude)packages/cli/src/release/notes.data.ts' \
  ':(exclude)packages/cli/test/copyHygiene.test.ts' | grep -E '^\+' | grep -v '^+++')

hits=$(printf '%s\n%s\n' "$md" "$src" | grep -E "$name_re" | grep -viE "$allow" || true)
if [ -n "$hits" ]; then
  echo ""
  echo "pre-commit: BLOCKED. A staged line writes scenri where the name goes:"
  echo "$hits" | head -5
  echo "  The product is Scenri. Lowercase is for identifiers: the command, @scenri/*,"
  echo "  SCENRI_*, ~/.scenri, scenri.co, scenri:* keys, filenames, tags and URLs."
  exit 1
fi
